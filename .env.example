# xAI Grok API — copy to .env.local and fill in your key
# Get a key at https://console.x.ai/
XAI_API_KEY=

# Optional model overrides
# GROK_VISION_MODEL=grok-2-vision-1212
# GROK_TEXT_MODEL=grok-3-latest

# Yale CAS — set true only after ITS registers this app's service URL
# Callback service URL: https://<your-host>/api/auth/cas/callback
YALE_CAS_ENABLED=false
# YALE_CAS_BASE_URL=https://secure.its.yale.edu/cas
